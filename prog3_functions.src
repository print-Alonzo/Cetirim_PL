// prog3_functions.src
// Demonstrates: function declarations, call by value,
//               array parameters, multiple return values (multi_type, 3+ types),
//               return statements, recursive function, let declarations,
//               multiple catch clauses, try without finally, char literal in arithmetic

// ---- Helper: absolute value (call by value) ----
int abs_val(int x) {
    if (x < 0) {
        return -x;
    }
    return x;
}

// ---- Swap two integers via multiple return values ----
(int, int) swap(int a, int b) {
    return b, a;
}

// ---- Sum an array (array parameter = call by reference) ----
int array_sum(int arr[], int len) {
    var int total, i;
    total = 0;
    for (i = 0; i < len; i = i + 1) {
        total = total + arr[i];
    }
    return total;
}

// ---- Multiple return values: min and max ----
(int, int) min_max(int arr[], int len) {
    var int mn, mx, i;
    mn = arr[0];
    mx = arr[0];
    for (i = 1; i < len; i = i + 1) {
        if (arr[i] < mn) {
            mn = arr[i];
        }
        if (arr[i] > mx) {
            mx = arr[i];
        }
    }
    return mn, mx;
}

// ---- Recursive factorial ----
int factorial(int n) {
    if (n <= 1) {
        return 1;
    }
    return n * factorial(n - 1);
}

// ---- Three return values: min, max, sum ----
(int, int, int) min_max_sum(int arr[], int len) {
    var int mn, mx, s, i;
    mn = arr[0];
    mx = arr[0];
    s = 0;
    for (i = 0; i < len; i = i + 1) {
        if (arr[i] < mn) { mn = arr[i]; }
        if (arr[i] > mx) { mx = arr[i]; }
        s = s + arr[i];
    }
    return mn, mx, s;
}

// ---- String builder using interpolated string ----
string make_greeting(string name, int count) {
    let msg = `Hello, {name}! You have {count} messages.`;
    return msg;
}

void main() {
    var int x, y, total, ascii_val;
    val int data[6] = {3, 7, 1, 9, 4, 6};
    let lo, hi = min_max(data, 6);
    let lo2, hi2, total2 = min_max_sum(data, 6);
    var string greeting;
    var int inbox;

    x = -15;
    print("abs(-15) =", abs_val(x));

    x = 10;
    y = 20;
    print("Before swap: x =", x, " y =", y);
    int sx, sy = swap(x, y);
    print("After swap:  x =", sx, " y =", sy);

    total = array_sum(data, 6);
    print("Array sum:", total);
    print("Min:", lo, "  Max:", hi);
    print("Min:", lo2, "Max:", hi2, "Sum:", total2);

    ascii_val = 'a' + 0;
    print("Char literal in arithmetic ('a'+0):", ascii_val);

    print("5! =", factorial(5));
    print("10! =", factorial(10));

    inbox = 4;
    greeting = make_greeting("Alonzo", inbox);
    print(greeting);

    // Named parameter call (syntax demonstration)
    print(make_greeting(name: "World", count: 0));

    // Multiple catch clauses (catch_list → catch_clause catch_list)
    // try without finally (finally_clause → ε)
    try {
        throw "first error";
    } catch (e1) {
        print("Caught first:", e1);
    } catch (e2) {
        print("Caught second:", e2);
    }
}
