// Feature fixture: an array size that is a runtime expression, not a
// compile-time literal - `ARR_NEW`'s size operand is computed at runtime.
void main() {
    var int n = 5;
    var int arr[n];
    var int i;

    for (i = 0; i < n; i = i + 1) {
        arr[i] = i * i;
    }
    for (i = 0; i < n; i = i + 1) {
        print(arr[i]);
    }
}
