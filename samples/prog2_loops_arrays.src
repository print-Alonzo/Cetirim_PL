// prog2_loops_arrays.src
// Demonstrates: for loop (C-style, range, collection), while loop,
//               repeat-until loop, arrays, array initializers, break, continue,
//               array declarator without init, let array decl,
//               empty for-init, empty for-update

const int SIZE = 5;

void main() {
    // Array declaration and initialization
    val int scores[5] = {95, 82, 77, 90, 68};
    var int buf[8];
    let primes[4] = {2, 3, 5, 7};
    var int i, sum, temp, swapped, n;
    var float average;

    // C-style for loop: compute sum
    sum = 0;
    for (i = 0; i < SIZE; i = i + 1) {
        sum = sum + scores[i];
    }
    average = sum / SIZE;
    print("Sum:", sum, "  Average:", average);

    // Range-based for loop
    print("Scores via range loop:");
    for (i in 0..4) {
        print("  scores[", i, "] =", scores[i]);
    }

    // Collection-style for loop over array identifier
    print("Scores via collection loop:");
    for (temp in scores) {
        print(" ", temp);
    }

    // While loop: bubble sort pass
    swapped = 1;
    while (swapped == 1) {
        swapped = 0;
        for (i = 0; i < SIZE - 1; i = i + 1) {
            if (scores[i] > scores[i + 1]) {
                temp = scores[i];
                scores[i] = scores[i + 1];
                scores[i + 1] = temp;
                swapped = 1;
            }
        }
    }

    print("Sorted scores:");
    for (i = 0; i < SIZE; i = i + 1) {
        print(scores[i]);
    }

    // Repeat-until loop: input validation
    repeat {
        print("Enter a positive number:");
        input(n);
    } until (n > 0);
    print("You entered:", n);

    // Break and continue demonstration
    print("Even numbers from 0 to 20 (skip multiples of 6):");
    for (i = 0; i <= 20; i = i + 2) {
        if (i % 6 == 0) {
            continue;
        }
        if (i > 18) {
            break;
        }
        print(i);
    }

    // Empty for-init: variable already set before the loop
    i = 0;
    for (; i < 4; i = i + 1) {
        print("prime:", primes[i]);
    }

    // Empty for-update: manual increment inside body
    for (i = 0; i < 4;) {
        buf[i] = primes[i] * 2;
        i = i + 1;
    }
    print("Doubled primes:", buf[0], buf[1], buf[2], buf[3]);
}
