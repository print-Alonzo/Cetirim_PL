// prog1_calculator.src
// Demonstrates: const (int/float/char/string/bool), var, val, int, float, input, print,
//               assignment, if-else, arithmetic expressions, zero-arg func call,
//               bare return, bool-returning function, unary plus, char literal in arithmetic

const int MAX_TRIES = 3;
const float PI = 3.14159;
const char SEPARATOR = '-';
const string APP_NAME = "Calculator";
const bool DEBUG = false;

void print_separator() {
    print(APP_NAME, SEPARATOR);
    return;
}

bool is_nonzero(int n) {
    return n != 0;
}

void main() {
    var int a, b, result, score, ascii_a;
    var float radius, area;
    val string label = "Result";

    print_separator();
    print("=== Basic Calculator ===");
    input(a, b);

    if (is_nonzero(b)) {
        result = +a + b;
        print("Unary plus sum:", result);
    }
    ascii_a = 'A' + 1;
    print("Char in arithmetic ('A'+1):", ascii_a);

    result = a + b;
    print("Addition:", label, result);

    result = a - b;
    print("Subtraction:", label, result);

    result = a * b;
    print("Multiplication:", label, result);

    if (b != 0) {
        result = a / b;
        print("Division:", label, result);
    } else {
        print("Error: division by zero");
    }

    // Circle area using PI constant
    print("Enter radius:");
    input(radius);
    area = PI * radius * radius;
    print("Circle area:", area);

    // Nested if-else: grade classifier
    print("Enter score (0-100):");
    input(score);

    if (score >= 90) {
        print("Grade: A");
    } else {
        if (score >= 75) {
            print("Grade: B");
        } else {
            if (score >= 60) {
                print("Grade: C");
            } else {
                print("Grade: F");
            }
        }
    }
}
